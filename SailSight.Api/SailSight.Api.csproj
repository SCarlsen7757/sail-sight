<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/OpenApi</OpenApiDocumentsDirectory>
    <AssemblyTitle>SailSight API</AssemblyTitle>
    <WebDirectory>$(MSBuildProjectDirectory)/../SailSight.Web</WebDirectory>
  </PropertyGroup>

  <UsingTask TaskName="_SetSkipDbMigrationEnv" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Fragment" Language="cs">
        System.Environment.SetEnvironmentVariable("SKIP_DB_MIGRATION", "true");
        System.Environment.SetEnvironmentVariable("Web__PublicBaseUrl", "https://localhost");
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_PrepareOpenApiGeneration" BeforeTargets="GenerateOpenApiDocuments">
    <_SetSkipDbMigrationEnv />
  </Target>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="Vakaros.Vkx.Parser.NET" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SailSight.Shared/SailSight.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data/Migrations/hypertables.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations/" />
  </ItemGroup>

  <!--
    OpenAPI document generation & TypeScript type generation
    =========================================================
    Microsoft.Extensions.ApiDescription.Server (dotnet-getdocument.dll) generates OpenAPI spec
    files at build time. When the document name is "v1" (the default), the tool intentionally
    omits the version from the filename → SailSight.Api.json.

    To add a v2 API:
      1. Register the additional version in Program.cs via AddApiVersioning opts.
      2. Add a second GenerateTypeScriptTypes target below (copy GenerateTypeScriptTypesV1,
         change Inputs to SailSight.Api_v2.json, Outputs to api-types-v2.ts, Command to "npm run gen:api:v2").
         (non-default document names are appended: {ProjectName}_{documentName}.json)
      3. The npm script "gen:api:v2" is already scaffolded in package.json.
      4. Document the new version's types in src/lib/schemas.ts.
  -->
  <!--
    Installs SailSight.Web's dependencies so the build works from a fresh clone. gen:api below runs
    out of that directory; without this the first `dotnet build SailSight.slnx` fails with
    "npm run gen:api exited with code 1".

    This is the *only* npm install in the solution — SailSight.Web.esproj sets
    ShouldRunNpmInstall=false. Two installers race over node_modules and fail with ENOTEMPTY, and
    an ordering dependency between the projects is not an option: it makes the JavaScript SDK copy
    the API's build output into SailSight.Web/.

    Hooking _GenerateProjectRestoreGraph as well as Restore is what puts this in the restore phase,
    which finishes before any project builds — so the web build finds node_modules already present
    even though nothing orders the two projects. (The SDK's own NPMRestore hook is an empty target,
    despite its comment; its install actually runs during build.)

    The Exists() guard matters for the API Dockerfile, which runs `dotnet restore` after copying
    only the two .csproj files and passes SkipTypeScriptGeneration=true to build/publish but not to
    restore. Without the guard this target fires in that layer and fails on a SailSight.Web that
    is not in the image context.

    The stamp lives inside node_modules, so removing that directory also removes it. Runs on a
    fresh clone (no stamp) and after a dependency change (package-lock.json newer); skipped
    otherwise. CI passes SkipTypeScriptGeneration=true for the API build and installs dependencies
    in its own step, so none of this affects CI.
  -->
  <Target Name="EnsureWebDependencies"
          AfterTargets="Restore;_GenerateProjectRestoreGraph"
          BeforeTargets="GenerateTypeScriptTypesV1"
          Condition="'$(SkipTypeScriptGeneration)' != 'true' AND Exists('$(WebDirectory)/package.json')"
          Inputs="$(WebDirectory)/package-lock.json"
          Outputs="$(WebDirectory)/node_modules/.sailsight-npm-ci.stamp">
    <Message Text="Installing SailSight.Web dependencies (npm ci)..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(WebDirectory)" />
    <Touch Files="$(WebDirectory)/node_modules/.sailsight-npm-ci.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GenerateTypeScriptTypesV1"
          AfterTargets="GenerateOpenApiDocuments"
          Condition="'$(SkipTypeScriptGeneration)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/OpenApi/SailSight.Api.json"
          Outputs="$(WebDirectory)/src/lib/api-types.ts">
    <Message Text="Generating TypeScript API types from OpenAPI spec (v1)..." Importance="high" />
    <Exec Command="npm run gen:api"
          WorkingDirectory="$(WebDirectory)" />
  </Target>

  <!--
    When v2 is ready, uncomment and adjust this target:

  <Target Name="GenerateTypeScriptTypesV2"
          AfterTargets="GenerateOpenApiDocuments"
          Condition="'$(SkipTypeScriptGeneration)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/OpenApi/v2.json"
          Outputs="$(MSBuildProjectDirectory)/../SailSight.Web/src/lib/api-types-v2.ts">
    <Message Text="Generating TypeScript API types from OpenAPI spec (v2)..." Importance="high" />
    <Exec Command="npm run gen:api:v2"
          WorkingDirectory="$(MSBuildProjectDirectory)/../SailSight.Web" />
  </Target>
  -->

</Project>
