# Dev-only image — used by docker-compose.override.yml.
# Source code is mounted as a volume at runtime, so JS/TS changes hot-reload
# instantly without rebuilding this image.
# Rebuild this image only when package.json dependencies change.
FROM node:26.9.0-alpine@sha256:dbaa92e5758cbbcf85d65d5403fdb530fe3442cbe8c6dbfb7ef23365450d5070
RUN apk add --no-cache 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0'
WORKDIR /app
COPY package*.json ./
RUN npm ci
EXPOSE 3000
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "dev"]
