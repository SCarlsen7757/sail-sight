# Dev-only image — used by docker-compose.override.yml.
# Source code is mounted as a volume at runtime, so JS/TS changes hot-reload
# instantly without rebuilding this image.
# Rebuild this image only when package.json dependencies change.
FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
RUN apk add --no-cache 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0' 'musl>=1.2.6-r3' 'musl-utils>=1.2.6-r3' 'zlib>=1.3.2-r1'
WORKDIR /app
COPY package*.json ./
COPY vendor ./vendor
RUN npm ci
EXPOSE 3000
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "dev"]
